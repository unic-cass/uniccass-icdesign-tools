# Copy this file to .env and adjust it for your workstation:
#   cp .env.example .env
#
# Keep this file compatible with both GNU Make and Bash: use KEY=value syntax,
# do not add `export`, and avoid spaces around `=`. Image defaults and tool,
# PDK, LibreLane, and Nix source revisions are read from manifest.json.

# Optional Docker image identity overrides. Leave empty to use manifest.json.
DOCKER_USER=
DOCKER_IMAGE=
DOCKER_TAG=

# Runtime project configuration
# Supported PDK values: ihp-sg13g2, sky130A, gf180mcuD
PDK=ihp-sg13g2
SHARED_DIR=${PWD}/shared_xserver

# Host ports mapped to services in the container
WEBSERVER_PORT=80
VNC_PORT=5901
JUPYTER_PORT=8888

# Docker build configuration
# Set ENABLE_GUI to a non-empty value to install GUI/VNC dependencies.
ENABLE_GUI=
# Leave empty to use build.arguments.MAX_BUILD_JOBS from manifest.json.
MAX_BUILD_JOBS=
BUILDKIT_PROGRESS=plain

# Optional complete output tag for direct build script usage. When empty,
# DOCKER_USER, DOCKER_IMAGE, and DOCKER_TAG determine the output image.
BUILD_IMAGE_TAG=

# Optional build and container controls. Any non-empty value enables the flag.
# STAGE applies to `make build`; for example, STAGE=magic.
STAGE=
NO_CACHE=
NO_PULL=
ROOT=

# Host integration is normally detected or inherited automatically. Uncomment
# only when the local X11 or audio setup requires an explicit value.
# DISPLAY=:0
# XAUTHORITY=/home/user/.Xauthority
# PULSE_SERVER=
